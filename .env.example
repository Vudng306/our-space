# ---------------------------------------------------------------------------
# Database — PostgreSQL
# Local dev (docker compose up -d) uses the URL below as-is.
# Production: paste your Neon / Supabase / RDS connection string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://ourspace:ourspace@localhost:5436/ourspace?schema=public"

# ---------------------------------------------------------------------------
# Auth — REQUIRED. Generate with:  openssl rand -base64 48
# Rotating this value logs everybody out.
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin of the app. Used to build invite links and reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Media storage
#   STORAGE_DRIVER=local  -> files under ./storage (dev / VPS with a disk)
#   STORAGE_DRIVER=s3     -> any S3-compatible bucket (Cloudflare R2, S3,
#                            Supabase Storage, Backblaze B2, MinIO...)
# Serverless hosts (Vercel) have a read-only filesystem: use s3 there.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Only needed when STORAGE_DRIVER=s3
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB="12"
MAX_PHOTOS_PER_MOMENT="10"

# ---------------------------------------------------------------------------
# Optional SMTP. Without it, password-reset links are written to the server
# log instead of being emailed (fine for a two-person app).
# ---------------------------------------------------------------------------
SMTP_URL=""
SMTP_FROM="Our Space <no-reply@localhost>"

# Set to "1" to stop any new account from being created once both of you
# have signed up. Recommended after your partner joins.
DISABLE_REGISTRATION="0"
